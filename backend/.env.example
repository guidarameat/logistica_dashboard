# Copie para backend/.env (lido automaticamente ao rodar a partir de backend/). Nunca commite o .env.

# Chave da OpenAI para ler imagens do Relatório Roteiro Entrega (opcional se só importar Excel).
OPENAI_API_KEY=

# Origem(ns) do frontend liberadas no CORS, separadas por vírgula, sem barra final.
# Em produção, use apenas o domínio real do frontend, ex.: https://dashboard.guidara.com.br
FRONTEND_URL=http://localhost:5173

# Porta do servidor (opcional; padrão 8090)
# SERVER_PORT=8090
